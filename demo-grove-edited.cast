[0.007, "o", "      replica ldr  \u2192  multinode-grove-demo-0-decode-0-decode-ldr-wwj5n         on aks-ndh100pool-13243571-vmss000004\r\n      replica ldr  \u2192  multinode-grove-demo-0-decode-1-decode-ldr-6m2rd         on aks-ndh100pool-13243571-vmss000009\r\n      replica wkr  \u2192  multinode-grove-demo-0-decode-0-decode-wkr-fpcks         on aks-ndh100pool-13243571-vmss000008\r\n      replica wkr  \u2192  multinode-grove-demo-0-decode-1-decode-wkr-5x9p5         on aks-ndh100pool-13243571-vmss00000a\r\n"]
[0.001, "o", "\r\n"]
[0.0, "o", "   \u001b[0;32m\u25b8 Both gangs ready\u001b[0m \u2014 4 pods across 4 nodes, two independent multinode workers\r\n\r\n"]
[0.0, "o", "   \u001b[1mWhat just happened:\u001b[0m\r\n"]
[0.0, "o", "   - You changed \u001b[0;36mreplicas: 1 \u2192 2\u001b[0m. One field.\r\n"]
[0.0, "o", "   - Grove created a second PCSG with its own 2-pod gang.\r\n   - Pods of the new gang stayed Pending TOGETHER until the scheduler\r\n"]
[0.0, "o", "     could admit them as a unit. No half-scheduled deadlock.\r\n"]
[0.0, "o", "   - The original replica kept serving the whole time \u2014 gangs are\r\n     independent, so scaling can't break what's already running.\r\n"]
[0.0, "o", "\r\n   \u001b[2mIf we had asked for replicas: 3 here (24 GPUs / 3 nodes), the third\u001b[0m\r\n"]
[0.0, "o", "   \u001b[2mgang would sit Pending as a whole until 8 GPUs free up \u2014 never\u001b[0m\r\n"]
[0.0, "o", "   \u001b[2mhalf-scheduled, never wasting GPUs. That's the gang guarantee.\u001b[0m\r\n"]
[8.414, "o", "\r\n\r\n"]
[0.001, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n  \u001b[0;35m\u001b[1m\ud83d\udcac Step 8: Prove It Works\u001b[0m\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# Final check \u2014 let's actually talk to the multinode worker.\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
[2.822, "o", "   Waiting up to 2 min for serving pods to be ready...\r\n"]
[4.64, "o", "\u001b[0;32m\u276f\u001b[0m kubectl port-forward svc/multinode-grove-demo-frontend 8000:8000 -n dynamo-test &\r\n"]
[0.003, "o", "   Waiting for port-forward"]
[0.133, "o", "."]
[1.459, "o", "."]
[1.455, "o", "."]
[3.011, "o", "\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# Sending a streaming request to the multinode decode worker...\u001b[0m\r\n\r\n"]
[0.0, "o", "\u001b[0;32m\u276f\u001b[0m curl http://localhost:8000/v1/chat/completions ...\r\n   \u001b[1mResponse:\u001b[0m "]
[5.956, "o", "We"]
[0.0, "o", "'re"]
[0.024, "o", " live"]
[0.12, "o", " and"]
[0.112, "o", " thriving"]
[0.154, "o", ","]
[0.098, "o", " successfully"]
[0.112, "o", " deployed"]
[0.132, "o", " across"]
[0.112, "o", " not"]
[0.12, "o", " one"]
[0.14, "o", ","]
[0.14, "o", " but"]
[0.133, "o", " two"]
[0.126, "o", " robust"]
[0.126, "o", " nodes"]
[0.168, "o", ","]
[0.091, "o", " expert"]
[0.119, "o", "ly"]
[0.155, "o", " managed"]
[0.363, "o", " by"]
[0.042, "o", " the"]
[0.118, "o", " efficiency"]
[0.119, "o", " powerhouse"]
[0.113, "o", " of"]
[0.127, "o", " Grove"]
[0.116, "o", " gang"]
[0.127, "o", " scheduling"]
[0.119, "o", "!"]
[0.148, "o", "\r\n"]
[0.017, "o", "\r\n"]
[4.232, "o", "\r\n\r\n"]
[0.001, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n  \u001b[0;35m\u001b[1m\ud83c\udf89 Recap\u001b[0m\r\n\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n\r\n   The problem:  \u001b[1mmodels that don't fit on one node.\u001b[0m\r\n"]
[0.001, "o", "\r\n   The options:\r\n     \u2022 Vanilla Deployment   \u2192  can't span nodes as one worker\r\n     \u2022 LWS                  \u2192  one role, one knob, no gang scheduler\r\n     \u2022 \u001b[1mGrove (via Dynamo DGD)\u001b[0m  \u2192  full disagg system in one spec\r\n\r\n   Grove gives you, in one DGD:\r\n     \u2705  PodCliqueSet           \u2014 the whole inference system as one object\r\n     \u2705  PodCliqueScalingGroup  \u2014 multinode workers as one gang\r\n     \u2705  Hierarchical gang      \u2014 gang scheduling at multiple layers, both within PCSGs and between them\r\n     \u2705  No half-scheduled      \u2014 pods of a gang admit together or wait together\r\n     \u2705  Startup ordering       \u2014 declarative, not scripted\r\n"]
[0.0, "o", "     \u2705  Independent autoscale  \u2014 prefill and decode on their own metrics\r\n\r\n   \u001b[1mYou wrote one field \u2014 multinode.nodeCount: 2.\u001b[0m\r\n   Grove and Dynamo did the rest.\r\n\r\n   \u001b[2m(DGD will be cleaned up on exit. Use --no-cleanup to keep it.)\u001b[0m\r\n\r\n"]
[0.0, "o", "   Learn more:\r\n     \u2022 Grove:  https://github.com/NVIDIA/grove\r\n     \u2022 Dynamo: https://github.com/ai-dynamo/dynamo\r\n"]
[0.001, "o", "     \u2022 Multinode docs: docs/kubernetes/deployment/multinode-deployment.md\r\n\r\n\r\n\u001b[2m# Cleaning up DGD (multinode-grove-demo)...\u001b[0m\r\n"]
[1.663, "o", "dynamographdeployment.nvidia.com \"multinode-grove-demo\" deleted from dynamo-test namespace\r\n"]
[0.011, "x", "0"]
