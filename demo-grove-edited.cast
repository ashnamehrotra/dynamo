[0.0, "o", "   \u001b[0;32m\u2705 DGD is successful \u2014 multinode worker is online\u001b[0m\r\n"]
[4.215, "o", "\r\n\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n"]
[0.0, "o", "  \u001b[0;35m\u001b[1m\ud83d\uddfa\ufe0f  Step 6: Topology \u2014 Where the Gang Landed\u001b[0m\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# With the gang up, let's see how Grove placed it.\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
[2.817, "o", "\u001b[0;32m\u276f\u001b[0m kubectl get pods -n dynamo-test -l nvidia.com/dynamo-graph-deployment-name=multinode-grove-demo -o wide\r\n"]
[1.676, "o", "NAME                                               READY   STATUS    RESTARTS   AGE     IP             NODE                                 NOMINATED NODE   READINESS GATES\r\nmultinode-grove-demo-0-decode-0-decode-ldr-wwj5n   1/1     Running   0          3m42s   10.244.3.224   aks-ndh100pool-13243571-vmss000004   <none>           <none>\r\nmultinode-grove-demo-0-decode-0-decode-wkr-fpcks   "]
[0.0, "o", "1/1     Running   0          3m42s   10.244.5.178   aks-ndh100pool-13243571-vmss000008   <none>           <none>\r\nmultinode-grove-demo-0-frontend-hlppz              1/1     Running   0          3m42s   10.244.2.53    aks-nodepool1-51802509-vmss000001"]
[0.0, "o", "    "]
[0.0, "o", "<none>           "]
[0.0, "o", "<none>\r\n"]
[0.006, "o", "\r\n"]
[4.218, "o", "   \u001b[1mWhat to look for:\u001b[0m\r\n   - Decode worker pods land on 2 different nodes\r\n"]
[0.0, "o", "     (one PCSG member per node \u2014 that's the multinode unit).\r\n"]
[0.001, "o", "   - Frontend lands wherever there's room \u2014 independent placement.\r\n"]
[7.022, "o", "\r\n\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n"]
[0.0, "o", "  \u001b[0;35m\u001b[1m\ud83d\udcc8 Step 7: Scale Out \u2014 Hierarchical Gang Scheduling\u001b[0m\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# Now the payoff. We have ONE multinode replica running (2 pods,\u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# 2 nodes, gang-scheduled together). Let's scale to TWO replicas.\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# What we expect Grove to do:\u001b[0m\r\n\r\n"]
[0.0, "o", "   - Create a SECOND PodCliqueScalingGroup with 2 new pods.\r\n"]
[0.0, "o", "   - Hold those 2 new pods Pending until ALL of them can\r\n"]
[0.0, "o", "     schedule together (the gang within the new PCSG).\r\n"]
[0.001, "o", "   - Treat each PCSG as an independent gang \u2014 the existing replica keeps\r\n"]
[0.0, "o", "     serving traffic regardless of what happens to the new one.\r\n\r\n"]
[0.0, "o", "   \u001b[1mThis is hierarchical gang scheduling:\u001b[0m gang within a PCSG, and\r\n"]
[0.0, "o", "   each PCSG independently gang-scheduled. One DGD field, two layers of gang.\r\n"]
[8.42, "o", "\r\n"]
[0.0, "o", "\u001b[0;32m\u276f\u001b[0m kubectl patch dgd multinode-grove-demo -n dynamo-test --type merge -p '{\"spec\":{\"services\":{\"decode\":{\"replicas\":2}}}}'\r\n"]
[1.961, "o", "dynamographdeployment.nvidia.com/multinode-grove-demo patched\r\n"]
[0.007, "o", "\r\n"]
[2.827, "o", "\r\n\u001b[0;36m# Watching the second gang form...\u001b[0m\r\n\r\n"]
[0.0, "o", "\u001b[1m  \ud83d\udcc8 Step 7: Scaling decode 1 \u2192 2 replicas\u001b[0m\r\n  \u001b[2mEvery 5s \u00b7 0s elapsed\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
