[0.0, "o", "        "]
[0.0, "o", " "]
[0.0, "o", "aks-nodepool1-51802509-vmss000001"]
[0.0, "o", "    "]
[0.0, "o", "<none>"]
[0.0, "o", "        "]
[0.0, "o", "   "]
[0.0, "o", "<none>"]
[0.0, "o", "\r\n"]
[0.003, "o", "\r\n"]
