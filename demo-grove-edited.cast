{"version": 3, "term": {"cols": 160, "rows": 42}, "timestamp": 1778870212, "idle_time_limit": 2.8, "command": "./demo-multinode-grove-narrated.sh", "title": "NVIDIA Dynamo + Grove \u2014 Multinode Llama-3.1-70B on AKS", "env": {"SHELL": "/bin/zsh"}}
[4.119, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.0, "o", "\r\n"]
[0.0, "o", "\u001b[0;36m\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557\u001b[0m\r\n"]
[0.0, "o", "\u001b[0;36m\u2551\u001b[0m  \u001b[1m\ud83c\udf33  Dynamo + Grove \u2014 Multinode Inference Made Simple  \ud83c\udf33\u001b[0m      \u001b[0;36m\u2551\u001b[0m\r\n"]
[0.0, "o", "\u001b[0;36m\u2551\u001b[0m                                                                \u001b[0;36m\u2551\u001b[0m\r\n"]
[0.0, "o", "\u001b[0;36m\u2551\u001b[0m     \u001b[0;35mOne DGD. Multiple nodes. Hierarchical gang scheduling.\u001b[0m     \u001b[0;36m\u2551\u001b[0m\r\n"]
[0.0, "o", "\u001b[0;36m\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d\u001b[0m\r\n\r\n"]
[4.238, "o", "\r\n\u001b[0;36m# Today's question:  what do you do when the model doesn't fit on one node?\u001b[0m\r\n\r\n   We'll cover three things:\r\n\r\n   1. \ud83e\uddf1  Why a normal Kubernetes Deployment can't help.\r\n   2. \ud83e\udd14  LeaderWorkerSet (LWS) \u2014 the obvious fallback \u2014 and where it stops.\r\n   3. \ud83c\udf33  Grove \u2014 Dynamo's preferred solution for k8s orchestration.\r\n\r\n"]
[7.028, "o", "\r\n\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n"]
[0.0, "o", "  \u001b[0;35m\u001b[1m\ud83e\uddf1 Step 1: The Multinode Wall\u001b[0m\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# Let's look at the cluster we have to work with.\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
[1.424, "o", "\u001b[0;32m\u276f\u001b[0m kubectl get nodes -o wide\r\n"]
[2.492, "o", "NAME                                 STATUS   ROLES    AGE     VERSION   INTERNAL-IP   EXTERNAL-IP   OS-IMAGE             KERNEL-VERSION      CONTAINER-RUNTIME\r\naks-ndh100pool-13243571-vmss000004   Ready    <none>   22d     v1.34.4   10.224.0.10   <none>        Ubuntu 22.04.5 LTS   5.15.0-1102-azure   containerd://1.7.30-2\r\naks-ndh100pool-13243571-vmss000008   Ready    <none>   21d     v1.34.4   10.224.0.7    <none>        Ubuntu 22.04.5 LTS   5.15.0-1102-azure   containerd://1.7.30-2\r\n"]
[0.0, "o", "aks-ndh100pool-13243571-vmss000009   Ready    <none>   21d     v1.34.4   10.224.0.8    <none>        Ubuntu 22.04.5 LTS   5.15.0-1102-azure   containerd://1.7.30-2\r\n"]
[0.0, "o", "aks-ndh100pool-13243571-vmss00000a   Ready    <none>   21d     v1.34.4   10.224.0.9    <none>        Ubuntu 22.04.5 LTS   5.15.0-1102-azure   containerd://1.7.30-2\r\naks-nodepool1-51802509-vmss000000    Ready    <none>   4d18h   v1.34.4   10.224.0.4    <none>        Ubuntu 22.04.5 LTS   5.15.0-1110-azure   containerd://1.7.31-1\r\naks-nodepool1-51802509-vmss000001    Ready    <none>   4d18h   v1.34.4   10.224.0.5    <none>        Ubuntu 22.04.5 LTS   5.15.0-1110-azure   containerd://1.7.31-1\r\naks-nodepool1-51802509-vmss000002    Ready    <none>   4d17h   v1.34.4   10.224.0.6    <none>        Ubuntu 22.04.5 LTS   5.15.0-1110-azure   containerd://1.7.31-1\r\n"]
[0.006, "o", "\r\n"]
[4.213, "o", "\u001b[0;32m\u276f\u001b[0m kubectl get nodes -o json | jq '.items[] | {node: .metadata.name, gpus: .status.allocatable[\"nvidia.com/gpu\"]}'\r\n"]
[2.614, "o", "   aks-ndh100pool-13243571-vmss000004             8 \u00d7 H100\r\n   aks-ndh100pool-13243571-vmss000008             8 \u00d7 H100\r\n   aks-ndh100pool-13243571-vmss000009             8 \u00d7 H100\r\n   aks-ndh100pool-13243571-vmss00000a             8 \u00d7 H100\r\n\r\n"]
[0.0, "o", "   Total: 4 GPU nodes, 32 GPUs, ~2560 GB VRAM\r\n"]
[5.621, "o", "\r\n"]
[0.001, "o", "\r\n\u001b[0;36m# Now consider the model we want to deploy: nvidia/Llama-3.1-70B-Instruct-FP8\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
[0.0, "o", "   Models like this:\r\n"]
[0.0, "o", "   - DeepSeek-R1 (671B FP8)          \u2192 ~640 GB of weights\r\n"]
[0.0, "o", "   - DeepSeek-R1 (671B BF16)         \u2192 ~1.3 TB of weights\r\n"]
[0.0, "o", "   - Llama-4-Maverick                \u2192 multi-node by design\r\n\r\n"]
[0.0, "o", "   A single H100 node = 8 \u00d7 80 GB = \u001b[1m640 GB\u001b[0m of VRAM.\r\n\r\n"]
[0.0, "o", "   \u001b[0;31m\u274c  Even FP8 671B fills a node \u2014 with no room for KV cache.\u001b[0m\r\n"]
[0.0, "o", "      You need a second node just to serve a single user, let alone scale.\r\n\r\n"]
[0.0, "o", "   \u001b[2m(For this live demo we'll deploy nvidia/Llama-3.1-70B-Instruct-FP8 across 2 nodes\u001b[0m\r\n"]
[0.0, "o", "   \u001b[2m so we don't sit through 30 minutes of CUDA-graph capture.\u001b[0m\r\n"]
[0.0, "o", "   \u001b[2m The Grove story below is identical for R1 \u2014 just change the\u001b[0m\r\n"]
[0.0, "o", "   \u001b[2m model path and bump nodeCount.)\u001b[0m\r\n"]
[7.021, "o", "\r\n"]
[0.001, "o", "\r\n\u001b[0;36m# The naive fix is a Kubernetes Deployment with replicas: 8. That doesn't work.\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
[0.0, "o", "   \u001b[1mWhy a vanilla Deployment fails for multinode inference:\u001b[0m\r\n\r\n"]
[0.0, "o", "   - \u001b[0;31mA Pod runs on ONE node.\u001b[0m Tensor parallelism across nodes needs\r\n"]
[0.0, "o", "     N pods that boot together, find each other, and form one logical worker.\r\n"]
[0.0, "o", "   - \u001b[0;31mNo gang scheduling.\u001b[0m If 7 pods schedule and the 8th pends on GPUs,\r\n"]
[0.0, "o", "     you've burned 7 nodes' worth of GPUs holding nothing.\r\n"]
[0.0, "o", "   - \u001b[0;31mNo startup ordering.\u001b[0m Workers must reach the leader on a known address\r\n"]
[0.0, "o", "     before the leader can call `init_process_group`.\r\n"]
[0.0, "o", "   - \u001b[0;31mNo topology awareness.\u001b[0m Pods can land in different racks; NCCL\r\n     all-reduce across the wrong fabric tanks throughput.\r\n\r\n   \u001b[1mYou need an orchestrator that treats N pods \u00d7 N nodes as one unit.\u001b[0m\r\n"]
[8.427, "o", "\r\n\r\n\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n"]
[0.0, "o", "  \u001b[0;35m\u001b[1m\ud83e\udd14 Step 2: Option A \u2014 LeaderWorkerSet (LWS)\u001b[0m\r\n\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# LeaderWorkerSet is the SIG-Apps project for this. It gets you partway there.\u001b[0m\r\n\r\n"]
[0.021, "o", "apiVersion: leaderworkerset.x-k8s.io/v1\r\n"]
[0.078, "o", "kind: LeaderWorkerSet\r\n"]
[0.095, "o", "metadata:\r\n"]
[0.076, "o", "  name: deepseek-decode\r\n"]
[0.078, "o", "spec:\r\n"]
[0.08, "o", "  replicas: 1                     # one logical worker\r\n"]
[0.076, "o", "  leaderWorkerTemplate:\r\n"]
[0.078, "o", "    size: 2                       # 1 leader + 1 worker pod\r\n"]
[0.077, "o", "    leaderTemplate: { ... }\r\n"]
[0.077, "o", "    workerTemplate: { ... }       # both pods together = one TP=16 worker\r\n"]
[0.076, "o", "\r\n"]
[4.22, "o", "   \u001b[0;32mWhat LWS gives you:\u001b[0m\r\n   \u2705  Leader+workers as one logical unit, replicated as a group\r\n"]
[0.0, "o", "   \u2705  Stable hostnames so the leader can find workers\r\n"]
[0.0, "o", "   \u2705  Basic gang behavior \u2014 the group restarts together on failure\r\n\r\n"]
[0.0, "o", "   \u001b[1;33mWhere LWS stops:\u001b[0m\r\n"]
[0.0, "o", "   \u26a0\ufe0f   \u001b[1mMultinode units may not be leader-worker shaped.\u001b[0m LWS uses\r\n"]
[0.0, "o", "        leader-worker groups to describe a multinode scaling unit. That works\r\n"]
[0.0, "o", "        for true leader-worker workloads, but gets awkward for disaggregated\r\n"]
[0.0, "o", "        serving: if prefill and decode are forced into one LWS, they can be\r\n"]
[0.0, "o", "        scheduled together, but cannot scale independently and the API gets clunky.\r\n"]
[0.0, "o", "\r\n"]
[0.0, "o", "   \u26a0\ufe0f   \u001b[1mSeparate LWS objects lose cross-component scheduling guarantees.\u001b[0m Modeling\r\n"]
[0.0, "o", "        prefill and decode separately avoids that awkward fit and preserves\r\n"]
[0.0, "o", "        independent scaling. Each LWS may still be gang-scheduled internally,\r\n"]
[0.0, "o", "        but there is no hierarchical gang scheduling or topology awareness\r\n"]
[0.0, "o", "        between them, so in the worst case you can get prefill with no decode.\r\n"]
[0.0, "o", "\r\n"]
[0.0, "o", "   \u26a0\ufe0f   \u001b[1mStartup ordering is tied to creation, not startup intent.\u001b[0m\r\n"]
[0.0, "o", "        LWS can order pod creation, but creation order is not startup or\r\n"]
[0.0, "o", "        readiness order. You want to gang-schedule the unit, then separately\r\n"]
[0.0, "o", "        say whether leaders or workers should start first.\r\n"]
[9.821, "o", "\r\n\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n"]
[0.0, "o", "  \u001b[0;35m\u001b[1m\ud83c\udf33 Step 2 (cont): Option B \u2014 Grove\u001b[0m\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# Grove is an open-source, Kubernetes-native API for describing an AI\u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# inference service \u2014 a modular component of Dynamo that can also run\u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# standalone or integrate with other inference frameworks. Where standard\u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# Kubernetes resources describe individual pods and services, Grove lets\u001b[0m\r\n"]
[0.001, "o", "\r\n\u001b[0;36m# you describe an entire inference serving system as one object: routing,\u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# \u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# prefill, decode, leader-worker groups, startup dependencies, and scaling\u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# boundaries \u2014 all in a single workload specification.\u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# \u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# Three hierarchical Kubernetes resources do the modeling:\u001b[0m\r\n\r\n"]
[2.874, "o", "   \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\n   \u2502                      PodCliqueSet  (PCS)                    \u2502\r\n   \u2502     The whole disaggregated system as ONE k8s object        \u2502\r\n   \u2502                                                             \u2502\r\n   \u2502   \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510   \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510 \u2502\r\n   \u2502   \u2502  PodClique   \u2502   \u2502   PodCliqueScalingGroup (PCSG)     \u2502 \u2502\r\n   \u2502   \u2502  (Frontend)  \u2502   \u2502    \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510    \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510    \u2502 \u2502\r\n   \u2502   \u2502              \u2502   \u2502    \u2502PodClique \u2502    \u2502PodClique \u2502    \u2502 \u2502\r\n   \u2502   \u2502  1 pod       \u2502   \u2502    \u2502 (decode  \u2502    \u2502 (decode  \u2502    \u2502 \u2502\r\n   \u2502   \u2502              \u2502   \u2502    \u2502  leader) "]
[0.0, "o", "\u2502    \u2502  worker) \u2502    \u2502 \u2502\r\n   \u2502   \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518   \u2502    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518    \u2502 \u2502\r\n   \u2502                      \u2502   N pods, scheduled & scaled       \u2502 \u2502\r\n   \u2502                      \u2502   together as a multinode unit     \u2502 \u2502\r\n   \u2502                      \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518 \u2502\r\n   \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\n"]
[7.02, "o", "\r\n   \u001b[0;32mWhat Grove adds on top of LWS:\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
[0.0, "o", "   \u2705  \u001b[1mMulti-component in one spec\u001b[0m \u2014 frontend + prefill + decode in one PCS.\r\n"]
[0.0, "o", "       The whole disagg system is one k8s object, not three.\r\n\r\n"]
[0.0, "o", "   \u2705  \u001b[1mFlexible gang scheduling\u001b[0m \u2014 gang the entire PCS (nothing runs\r\n"]
[0.0, "o", "       until the whole stack can schedule), or gang inside a PCSG only\r\n"]
[0.0, "o", "       (multinode workers boot together but frontend can come up early).\r\n\r\n"]
[0.0, "o", "   \u2705  \u001b[1mHierarchical gang scheduling\u001b[0m \u2014 the workload can express\r\n"]
[0.0, "o", "       service-level viability, e.g. require a complete prefill AND a complete\r\n"]
[0.0, "o", "       decode before the deployment is considered ready to serve. The scheduler\r\n"]
[0.0, "o", "       won't admit complete-but-unbalanced capacity that can't handle an end-to-end request.\r\n\r\n"]
[0.0, "o", "   \u2705  \u001b[1mDeclarative startup dependencies\u001b[0m \u2014 \"decode starts after prefill\r\n"]
[0.0, "o", "       is ready\" is a field, not a scripted readiness probe dance.\r\n\r\n   \u2705  \u001b[1mIndependent multi-level autoscaling\u001b[0m \u2014 scale prefill PCSGs and\r\n"]
[0.0, "o", "       decode PCSGs on different metrics, in the same DGD. Planner-driven\r\n       scale-out adds a complete, gang-admitted instance \u2014 not loose pods.\r\n\r\n"]
[0.0, "o", "   \u2705  \u001b[1mBuilt on a gang scheduler\u001b[0m (KAI / podgang) \u2014 no half-scheduled\r\n"]
[0.0, "o", "       deadlocks where 7 of 8 pods are running and 1 is pending forever.\r\n"]
[11.222, "o", "\r\n\r\n\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n"]
[0.0, "o", "  \u001b[0;35m\u001b[1m\ud83d\udcdd Step 3: The DGD \u2014 All Of That, In One YAML\u001b[0m\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# Here's the DynamoGraphDeployment we're about to apply.\u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# Notice how little there is: ONE field unlocks multinode.\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
[2.824, "o", "\u001b[2m# multinode-grove-demo.yaml\u001b[0m\r\n"]
[0.015, "o", "apiVersion: nvidia.com/v1alpha1\r\n"]
[0.069, "o", "kind: DynamoGraphDeployment\r\n"]
[0.076, "o", "metadata:\r\n"]
[0.073, "o", "  name: multinode-grove-demo\r\n"]
[0.074, "o", "  namespace: dynamo-test\r\n"]
[0.074, "o", "  labels:\r\n"]
[0.074, "o", "    demo: multinode-grove\r\n"]
[0.074, "o", "spec:\r\n"]
[0.073, "o", "  backendFramework: sglang\r\n"]
[0.066, "o", "  envs:\r\n"]
[0.073, "o", "    # Point HuggingFace cache at the PVC mount; weights are pre-downloaded\r\n"]
[0.07, "o", "    # so workers don't have to hit the HuggingFace API.\r\n"]
[0.074, "o", "    - name: HF_HOME\r\n"]
[0.073, "o", "      value: /model-store\r\n"]
[0.069, "o", "    # \u2500\u2500 NCCL tuning for AKS H100 multinode \u2500\u2500\r\n"]
[0.071, "o", "    # AKS Azure-overlay CNI doesn't expose IB to NCCL's auto-detect;\r\n"]
[0.074, "o", "    # force TCP over the pod's eth0 and disable IB so NCCL doesn't\r\n"]
[0.076, "o", "    # spin forever trying to negotiate a transport that won't work.\r\n"]
[0.07, "o", "    - name: NCCL_IB_DISABLE\r\n"]
[0.07, "o", "      value: \"1\"\r\n"]
[0.071, "o", "    - name: NCCL_SOCKET_IFNAME\r\n"]
[0.074, "o", "      value: eth0\r\n"]
[0.073, "o", "    - name: GLOO_SOCKET_IFNAME\r\n"]
[0.07, "o", "      value: eth0\r\n"]
[0.069, "o", "    - name: NCCL_DEBUG\r\n"]
[0.069, "o", "      value: INFO\r\n"]
[0.07, "o", "\r\n"]
[0.069, "o", "  services:\r\n"]
[0.074, "o", "    Frontend:\r\n"]
[0.073, "o", "      componentType: frontend\r\n"]
[0.076, "o", "      replicas: 1\r\n"]
[0.074, "o", "      extraPodSpec:\r\n"]
[0.073, "o", "        mainContainer:\r\n"]
[0.074, "o", "          image: nvcr.io/nvidia/ai-dynamo/sglang-runtime:1.0.1\r\n"]
[0.073, "o", "          command: [\"python3\"]\r\n"]
[0.074, "o", "          args: [\"-m\", \"dynamo.frontend\"]\r\n"]
[0.07, "o", "          volumeMounts:\r\n"]
[0.074, "o", "            - name: model-cache\r\n"]
[0.073, "o", "              mountPath: /model-store\r\n"]
[0.076, "o", "        volumes:\r\n"]
[0.069, "o", "          - name: model-cache\r\n"]
[0.073, "o", "            persistentVolumeClaim:\r\n"]
[0.071, "o", "              claimName: model-cache\r\n"]
[0.067, "o", "\r\n"]
[0.074, "o", "    decode:\r\n"]
[0.073, "o", "      componentType: worker\r\n"]
[0.073, "o", "      subComponentType: decode\r\n"]
[0.074, "o", "      replicas: 1\r\n"]
[0.073, "o", "      # \u2500\u2500 This is the Grove multinode primitive \u2500\u2500\r\n"]
[0.076, "o", "      # Tells the operator to create a PodCliqueScalingGroup with\r\n"]
[0.074, "o", "      # 2 pods that scale and gang-schedule together.\r\n"]
[0.074, "o", "      multinode:\r\n"]
[0.071, "o", "        nodeCount: 2\r\n"]
[0.071, "o", "      resources:\r\n"]
[0.073, "o", "        limits:\r\n"]
[0.074, "o", "          gpu: \"8\"\r\n"]
[0.074, "o", "      extraPodSpec:\r\n"]
[0.073, "o", "        mainContainer:\r\n"]
[0.069, "o", "          image: nvcr.io/nvidia/ai-dynamo/sglang-runtime:1.0.1\r\n"]
[0.074, "o", "          command: [\"python3\"]\r\n"]
[0.074, "o", "          args:\r\n"]
[0.074, "o", "            - \"-m\"\r\n"]
[0.073, "o", "            - \"dynamo.sglang\"\r\n"]
[0.073, "o", "            - \"--model-path\"\r\n"]
[0.076, "o", "            - \"/model-store/hub/models--nvidia--Llama-3.1-70B-Instruct-FP8/snapshots/07a08be3d8a8f5254c2aba375b79743bca8fd491\"\r\n"]
[0.07, "o", "            - \"--served-model-name\"\r\n"]
[0.069, "o", "            - \"nvidia/Llama-3.1-70B-Instruct-FP8\"\r\n"]
[0.071, "o", "            - \"--tensor-parallel-size\"\r\n"]
[0.069, "o", "            - \"16\"\r\n"]
[0.071, "o", "            - \"--trust-remote-code\"\r\n"]
[0.074, "o", "          volumeMounts:\r\n"]
[0.071, "o", "            - name: model-cache\r\n"]
[0.076, "o", "              mountPath: /model-store\r\n"]
[0.07, "o", "        volumes:\r\n"]
[0.074, "o", "          - name: model-cache\r\n"]
[0.074, "o", "            persistentVolumeClaim:\r\n"]
[0.073, "o", "              claimName: model-cache\r\n"]
[0.071, "o", "\r\n"]
[4.218, "o", "   \u001b[1mThe single field that does the work:\u001b[0m\r\n\r\n"]
[0.0, "o", "      \u001b[0;36mservices.decode.multinode.nodeCount: 2\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
[0.0, "o", "   That tells the Dynamo operator: \"the decode worker is 2 pods\r\n"]
[0.0, "o", "   pinned to 2 nodes, gang-scheduled, with stable hostnames\".\r\n\r\n"]
[0.0, "o", "   The operator translates that into a Grove PodCliqueScalingGroup.\r\n"]
[0.0, "o", "   You don't write Grove YAML directly \u2014 the DGD is your interface.\r\n"]
[7.02, "o", "\r\n\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n"]
[0.0, "o", "  \u001b[0;35m\u001b[1m\ud83d\ude80 Step 4: Apply\u001b[0m\r\n"]
[0.001, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# One kubectl apply. Then we watch Grove do its thing.\u001b[0m\r\n\r\n"]
[2.811, "o", "\u001b[0;32m\u276f\u001b[0m kubectl apply -f multinode-grove-demo.yaml\r\n"]
[3.662, "o", "dynamographdeployment.nvidia.com/multinode-grove-demo created\r\n"]
[4.215, "o", "\r\n\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n  \u001b[0;35m\u001b[1m\ud83d\udc40 Step 5: Watch the Gang Form\u001b[0m\r\n"]
[0.0, "o", "\u001b[1m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# Watch closely: with Grove, pods stay Pending until the WHOLE gang\u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# can schedule. Then they all transition together. No half-scheduled\u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[0;36m# deadlocks where 7 nodes hold GPUs waiting for an 8th that never comes.\u001b[0m\r\n\r\n"]
[4.217, "o", "\u001b[1m  \ud83d\udc40 Step 5: Watching Grove Primitives\u001b[0m\r\n  \u001b[2mEvery 5s \u00b7 0s elapsed\u001b[0m\r\n\r\n"]
[0.0, "o", "\u001b[0;32m\u276f\u001b[0m kubectl get podcliqueset,podclique,podcliquescalinggroup -n dynamo-test\r\n"]
[3.882, "o", "NAME                                         AGE\r\npodcliqueset.grove.io/multinode-grove-demo   7s\r\n"]
[0.003, "o", "NAME                                                            AGE\r\npodclique.grove.io/multinode-grove-demo-0-decode-0-decode-ldr   7s\r\npodclique.grove.io/multinode-grove-demo-0-decode-0-decode-wkr   7s\r\npodclique.grove.io/multinode-grove-demo-0-frontend              7s\r\n"]
[0.0, "o", "NAME                                                           AGE\r\npodcliquescalinggroup.grove.io/multinode-grove-demo-0-decode   8s\r\n"]
[0.006, "o", "\r\n"]
[0.0, "o", "\u001b[0;32m\u276f\u001b[0m kubectl get pods -n dynamo-test -l nvidia.com/dynamo-graph-deployment-name=multinode-grove-demo -o wide\r\n"]
[4.179, "o", "NAME                                               READY   STATUS              RESTARTS   AGE   IP             NODE                                 NOMINATED NODE"]
[0.0, "o", "   READINESS GATES\r\nmultinode-grove-demo-0-decode-0-decode-ldr-wwj5n   0/1     Running             0          11s   10.244.3.224   aks-ndh100pool-13243571-vmss000004   "]
[0.0, "o", "<none>        "]
[0.0, "o", "   "]
[0.0, "o", "<none>"]
