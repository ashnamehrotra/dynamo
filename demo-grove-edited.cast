[0.0, "o", "        "]
[0.0, "o", "   "]
[0.0, "o", "<none>"]
[0.0, "o", "\r\n"]
[0.0, "o", "multinode-grove-demo-0-frontend-hlppz"]
[0.0, "o", "        "]
[0.0, "o", "      "]
[0.0, "o", "0/1"]
[0.0, "o", "     "]
[0.0, "o", "ContainerCreating"]
[0.0, "o", "   0          11s   "]
