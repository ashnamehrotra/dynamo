[0.000, "o", "\u001b[1;36m# Step 5: Request WITH x-dynamo-session-id — creates a Program\u001b[0m\r\n"]
[1.024, "o", "\u001b[0;90m  Adding the session header tells ThunderAgent this is an agent turn.\u001b[0m\r\n"]
[2.013, "o", "\u001b[0;90m  It creates a Program entry, sets status=REASONING, and pins to a worker.\u001b[0m\r\n"]
